# Bubble Sort in Python

def bubble_sort(arr):
    n = len(arr)

    for i in range(n):
        swapped = False

        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                # Swap elements
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True

        # If no swapping occurred, array is already sorted
        if not swapped:
            break

    return arr


# Example
numbers = [64, 34, 25, 12, 22, 11, 90]

print("Original Array:", numbers)
bubble_sort(numbers)
print("Sorted Array:", numbers)